# Environment variables
SECRET_KEY=place_holder
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
GOOGLE_CLIENT_ID=place_holder
GOOGLE_CLIENT_SECRET=place_holder

# Database configurations
POSTGRES_USER=place_holder
POSTGRES_PASSWORD=place_holder
POSTGRES_DB=domidata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Formato: postgresql://user:password@host:port/db
# Url de conexão com o banco de dados
DATABASE_URL=postgresql+asyncpg://place_holder:place_holder@db:5432/domidata
